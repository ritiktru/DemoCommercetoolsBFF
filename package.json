{
  "name": "commercetools-bff-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "catalog:product-type": "node --import tsx scripts/import-product-type.ts",
    "catalog:products": "node --import tsx scripts/import-products.ts",
    "catalog:poc-prices": "node --import tsx scripts/map-poc-prices.ts",
    "catalog:selections": "node --import tsx scripts/import-product-selections.ts",
    "stores:import": "node --import tsx scripts/import-stores.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
